@using BookManager.Domain.Enums
@using BookManager.Web.Components.Shared.BookCard
@using BookManager.Web.Components.Shared.Input
@using BookManager.Web.Components.Shared.Select
@using BookManager.Web.States

@inject TailwindMerge.TwMerge TwMerge

@inject BookState BookState
@implements IDisposable

<div class="@TwMerge.Merge(
    "w-full flex flex-col",
    IsEmpty ? "gap-18" : "gap-6")
">
    @* FILTER *@
    <div class="flex flex-col gap-2 w-full md:flex-row md:gap-4">
        <Input
            Type="text"
            Id="search"
            Placeholder="Buscar por título ou autor"
            @bind-Value="@SearchQuery"
            @bind-Value:after="@OnSearchQueryChanged"
        >
            <LeftIcon>
                <Blazicon Svg="Lucide.Search" class="text-[16px] text-gray-400" />
            </LeftIcon>
        </Input>

        <Select Value="@SelectedFilter" ValueChanged="@OnFilterByChanged">
            <SelectTrigger ClassName="w-full md:w-48">
                <SelectedValue Placeholder="Filtrar por" />
            </SelectTrigger>

            <SelectContent>
                @foreach (var option in FilterOptions)
                {
                    <SelectItem Value="@option" ClassName="w-full flex items-center gap-2">
                        @option.Label

                        @if (option.Value == SelectedFilter?.Value)
                        {
                            <div class="ml-auto">
                                <Blazicon Svg="Lucide.Check" class="text-[16px] text-green-base" />
                            </div>
                        }
                    </SelectItem>
                }
            </SelectContent>
        </Select>
    </div>

    @if (IsEmpty)
    {
        <p class="body-md text-gray-400 text-center">
            Nenhum livro adicionado ainda. Comece adicionando seu primeiro livro!
        </p>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 w-fit mx-auto sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 justify-items-center">
            @foreach (var book in BookState.books)
            {
                <BookCard Book="@book" />
            }
        </div>
    }
</div>

@code {
    private string SearchQuery { get; set; } = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool IsEmpty => !BookState.books.Any();

    private List<Item> FilterOptions { get; set; } = new List<Item>
    {
        new Item { Value = "", Label = "Todos os status" },
        new Item { Value = "0", Label = "Quero ler" },
        new Item { Value = "1", Label = "Lendo" },
        new Item { Value = "2", Label = "Lido" }
    };

    private Item? SelectedFilter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        BookState.OnChange += StateHasChanged;

        SelectedFilter = FilterOptions.FirstOrDefault();

        await FilterBooksAsync(SearchQuery, null);
    }

    public void Dispose()
    {
        BookState.OnChange -= StateHasChanged;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }

    private async Task FilterBooksAsync(string searchQuery, ReadStatus? readStatus)
    {
        BookState.FilterBooks(searchQuery, readStatus);
    }

    private async Task OnFilterByChanged(Item newItem)
    {
        SelectedFilter = newItem;

        ReadStatus? selectedReadStatus = string.IsNullOrWhiteSpace(SelectedFilter?.Value) 
            ? null 
            : int.TryParse(SelectedFilter.Value, out var statusValue) ? (ReadStatus)statusValue : null;

        await FilterBooksAsync(SearchQuery, selectedReadStatus);
    }

    private async Task OnSearchQueryChanged()
    {
        // Cancel the previous debounce task if it exists
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();

        try
        {
            // Wait for 500 milliseconds before executing the search
            await Task.Delay(500, _debounceCts.Token);

            await FilterBooksAsync(SearchQuery, null);
        }
        catch (TaskCanceledException)
        {
            // Uma nova tecla foi pressionada antes dos 500ms.
        }
    }
}