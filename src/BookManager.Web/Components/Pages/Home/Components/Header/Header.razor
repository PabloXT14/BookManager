@using BookManager.Web.Components.Pages.Home.Components.Summaries
@using BookManager.Web.Components.Shared.Button
@using BookManager.Web.Components.Shared.Dialog
@using BookManager.Web.Components.Shared.Input
@using BookManager.Web.Components.Shared.Rating
@using BookManager.Web.Components.Shared.Select
@using BookManager.Web.Components.Shared.TextArea

<header class="w-full flex flex-col gap-6">
    @* TOP *@
    <div class="w-full flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
            <Blazicon
                Svg="Lucide.BookOpen"
                class="text-[32px] text-navy-low"
            />

            <span class="body-md text-gray-500">Minha Biblioteca</span>
        </a>


        <Dialog IsOpen="@IsDialogOpen" OpenChanged="@((isOpen) => IsDialogOpen = isOpen)">
            <DialogTrigger>
                <Button ClassName="w-fit">
                    <Blazicon
                        Svg="Lucide.Plus"
                        class="text-[16px]"
                    />

                    Adicionar livro
                </Button>
            </DialogTrigger>
            
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Adicionar Livro</DialogTitle>
                </DialogHeader>

                @* FORM *@
                <div class="w-full flex flex-col gap-4">
                    <Input
                        Id="book-title"
                        Type="text"
                        Label="Título *"
                        Placeholder="Digite o título do livro"
                    />

                    <Input
                        Id="book-author"
                        Type="text"
                        Label="Autor *"
                        Placeholder="Digite o nome do autor"
                    />

                    <Input
                        Id="book-url"
                        Type="text"
                        Label="URL da Imagem"
                        Placeholder="URL da capa do livro (opcional)"
                    />


                    @* SELECT *@
                    <div class="flex flex-col gap-2">
                        <label class="text-gray-500 text-sm font-medium leading-none" for="book-status">
                            Status
                        </label>

                        <Select Value="@StatusSelected" ValueChanged="@OnStatusSelectedChanged">
                            <SelectTrigger ClassName="w-full" Id="book-status">
                                <SelectedValue Placeholder="Filtrar por" />
                            </SelectTrigger>

                            <SelectContent>
                                @foreach (var option in StatusOptions)
                                {
                                    <SelectItem Value="@option" ClassName="w-full flex items-center gap-2">
                                        @option.Label

                                        @if (option.Value == StatusSelected?.Value)
                                        {
                                            <div class="ml-auto">
                                                <Blazicon Svg="Lucide.Check" class="text-[16px] text-green-base" />
                                            </div>
                                        }
                                    </SelectItem>
                                }
                            </SelectContent>
                        </Select>
                    </div>

                    @* RATING *@
                    <div class="flex flex-col gap-2">
                        <Rating
                            Title="Avaliação"
                            Stars="@Rating"
                            Id="book-rating"
                            OnStarsChanged="@HandleRatingChanged"
                            OnClearAll="@(() => HandleRatingChanged(0))"
                        />
                    </div>

                    <TextArea
                        Id="book-comment"
                        Label="Comentário"
                        Placeholder="Suas anotações sobre o livro (opcional)"
                    />

                    @* FOOTER *@
                    <div class="flex items-center justify-end gap-2">
                        <Button
                            ClassName="w-fit"
                            Variant="Button.Variants.Secondary"
                            @onclick="@HandleCloseDialog"
                        >
                            Cancelar
                        </Button>

                        <Button ClassName="w-fit">
                            Adicionar
                        </Button>
                    </div>
                </div>
                
            </DialogContent>
        </Dialog>
    </div>
    
    @* BOTTOM *@
    <Summaries />
</header>

@code {
    public bool IsDialogOpen { get; set; } = false;

    public List<Item> StatusOptions { get; set; } = new List<Item>
    {
        new Item { Value = "0", Label = "Quero ler" },
        new Item { Value = "1", Label = "Lendo" },
        new Item { Value = "2", Label = "Lido" }
    };

    public Item? StatusSelected { get; set; }

    public int Rating { get; set; }


    protected override void OnAfterRender(bool firstRender)
    {
        StatusSelected = StatusOptions.FirstOrDefault();
        Rating = 0;
    }

    public async Task OnStatusSelectedChanged(Item value)
    {
        StatusSelected = value;
    }

    public void HandleCloseDialog()
    {
        IsDialogOpen = false;
    }

    public void HandleRatingChanged(int value)
    {
        Rating = value;
    }
}