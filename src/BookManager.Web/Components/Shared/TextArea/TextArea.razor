@inherits InputBase<string?>

@inject TailwindMerge.TwMerge TwMerge

<div class="@ComputedClasses">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="text-gray-500 text-sm font-medium leading-none">
            @Label
        </label>
    }

    <textarea
        id="@Id"
        class="min-h-20 bg-gray-100 text-gray-500 body-sm px-3 py-2 rounded-lg outline-none focus:ring-2 focus:ring-gray-200 w-full transition-colors placeholder:text-gray-400 resize-none disabled:opacity-50 disabled:cursor-not-allowed"
        placeholder="@Placeholder"
        @oninput="EventCallback.Factory.CreateBinder<string?>(this, v => CurrentValueAsString = v, CurrentValueAsString)"
        @attributes="AdditionalAttributes"
    />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <span class="text-red-500 text-sm font-medium leading-none">
            @ErrorMessage
        </span>
    }
</div>


@code {
    [Parameter]
    public string? ClassName { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }
    
    private string ComputedClasses => TwMerge.Merge(
        "flex flex-col gap-2",
        ClassName
    ) ?? "";

    protected override bool TryParseValueFromString(string? value, out string? result, out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }
}