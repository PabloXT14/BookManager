@inject TailwindMerge.TwMerge TwMerge

@implements IDisposable

<CascadingValue Value="_context">
    <div
        class="relative"
    >
        @* OVERLAY *@
        <div
            class="@TwMerge.Merge(
                "fixed inset-0 z-0",
                _context.IsOpen ? "" : "hidden"
            )"
            @onclick="_context.Close"
        ></div>

        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public Item? Value { get; set; }

    [Parameter]
    public EventCallback<Item?> ValueChanged { get; set; }

    private readonly SelectContext _context = new();


    protected override void OnInitialized()
    {
        _context.StateChanged += Refresh;

        _context.OnValueChanged = async (value) =>
        {
            Value = value;
            await ValueChanged.InvokeAsync(value);
        };
        
        // Set the initial value in the context
        _context.SyncValue(Value);
    }

    protected override void OnParametersSet()
    {
        // Update the context's value if the Value parameter changes
        _context.SyncValue(Value);
    }

    public void Dispose()
    {
        _context.StateChanged -= Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }
}