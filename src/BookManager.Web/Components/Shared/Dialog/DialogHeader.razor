@inject TailwindMerge.TwMerge TwMerge

<div class="@ComputedClasses">
    @ChildContent

    <button
        class="absolute top-1.5 right-0"
        @onclick="@Context.CloseAsync"
    >
        <Blazicon
            Svg="Lucide.X"
            class="text-[16px] text-gray-500 hover:text-gray-700 transition-colors"
        />
    </button>
</div>

@code {
    [CascadingParameter]
    public DialogContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? ClassName { get; set; }

    public string ComputedClasses => TwMerge.Merge(
        "relative w-full flex flex-col gap-2",
        ClassName
    ) ?? "";
}