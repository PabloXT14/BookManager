@inject TailwindMerge.TwMerge TwMerge

<p class="@ComputedClasses">
    @ChildContent
</p>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? ClassName { get; set; }

    public string ComputedClasses => TwMerge.Merge(
        "text-sm text-gray-400",
        ClassName
    ) ?? "";
}